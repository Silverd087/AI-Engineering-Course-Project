# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=

# Any OpenAI chat model that supports tool calling.
AGENT_MODEL=

# Prices for the cost meter, USD per 1M tokens (check the provider's pricing page).
PRICE_INPUT_PER_MTOK=0
PRICE_OUTPUT_PER_MTOK=0

# Stop rule limits.
MAX_STEPS=25
MAX_COST_USD=0.20
MAX_REPEATS=3
TASK_TIMEOUT_S=300

# LangSmith tracing (optional). Put the real key only in .env.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=cs496-operator